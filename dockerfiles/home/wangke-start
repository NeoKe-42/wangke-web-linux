#!/bin/bash
# WangKe Web Linux entrypoint.
#
# Pre-warms the small set of commands that are both (a) on the user's hot path
# and (b) proven to return quickly without touching the emulated kernel's RNG,
# so the first interactive invocation is fast (disk blocks paged in + CheerpX
# JIT done). Then it hands over to the login shell.
#
# python3 and git are intentionally NOT pre-warmed: python3's start-up calls
# getrandom(), which blocks while the kernel's CRNG is still empty early in
# boot, and that wait is NOT signal-interruptible under CheerpX -- so a
# foreground run would hang the shell (timeout cannot kill it) and a detached
# background run starves the boot of disk/CPU and delays the prompt. Both work
# normally at the prompt once the RNG is ready. `timeout` still guards the
# foreground warm-up so an unexpected hang can never block the shell.
#
# PATH is set explicitly because CheerpX launches the CMD with a custom env
# that does not include PATH.

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin

printf '\033[90mPreparing frequently used commands...\033[0m\n'

timeout 6 ls / >/dev/null 2>&1 || true
timeout 6 free -h >/dev/null 2>&1 || true
timeout 6 df -h >/dev/null 2>&1 || true

printf '\033[32mSystem ready.\033[0m\n'

exec /bin/bash --login
