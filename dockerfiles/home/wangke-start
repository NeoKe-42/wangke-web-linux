#!/bin/bash
# TEMPORARY diagnostic entrypoint: prints a marker before/after each warm-up
# command so a live boot log reveals exactly which command hangs. Reverted once
# the culprit is identified.
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin

printf '\033[90mPreparing frequently used commands...\033[0m\n'

printf '\033[90m[M] pre-timeout-true\033[0m\n'
timeout 6 true >/dev/null 2>&1
printf '\033[90m[M] post-timeout-true rc=%s\033[0m\n' "$?"

printf '\033[90m[M] pre-ls\033[0m\n'
timeout 6 ls / >/dev/null 2>&1
printf '\033[90m[M] post-ls rc=%s\033[0m\n' "$?"

printf '\033[90m[M] pre-free\033[0m\n'
timeout 6 free -h >/dev/null 2>&1
printf '\033[90m[M] post-free rc=%s\033[0m\n' "$?"

printf '\033[90m[M] pre-df\033[0m\n'
timeout 6 df -h >/dev/null 2>&1
printf '\033[90m[M] post-df rc=%s\033[0m\n' "$?"

printf '\033[90m[M] pre-py\033[0m\n'
timeout 12 python3 -c "pass" >/dev/null 2>&1
printf '\033[90m[M] post-py rc=%s\033[0m\n' "$?"

printf '\033[90m[M] pre-git\033[0m\n'
timeout 8 git --version >/dev/null 2>&1
printf '\033[90m[M] post-git rc=%s\033[0m\n' "$?"

printf '\033[32mSystem ready.\033[0m\n'
exec /bin/bash --login
