# WangKe Web Linux: colored prompt (fixed hostname) + color aliases.
force_color_prompt=yes
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias diff='diff --color=auto'

# Browser integration: xterm.js handles this private OSC sequence and opens
# the project blog. The plain URL remains as a clickable popup-blocker fallback.
blog() {
	printf '\033]777;wangke:open-blog\007'
	printf 'Blog: https://neoke-42.github.io/wangke-web-linux/blog\n'
}

PS1='\[\033[01;32m\]\u@web-linux\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
