# Copy to .env to override the default VM configuration for local development.
#
# Use a locally built custom image (see scripts/build-image.sh):
# VITE_DISK_IMAGE_URL=/custom-disk-images/wangke.ext2
# VITE_DISK_IMAGE_TYPE=bytes
# VITE_VM_CWD=/home/wangke
#
# Or use the official WebVM cloud image (default when nothing is set):
# VITE_DISK_IMAGE_URL=wss://disks.webvm.io/debian_buster_large_permis_fixed_01-06-2026.ext2
# VITE_DISK_IMAGE_TYPE=cloud
